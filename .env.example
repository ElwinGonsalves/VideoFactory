# Copy to .env (gitignored) or fill these in the UI: Settings tab.
# Language model (default provider: Gemini free tier, key from https://aistudio.google.com/api-keys)
GEMINI_API_KEY=
# Optional offline fallback: install Ollama, then `ollama pull qwen2.5:7b` (~4.7 GB disk)
OLLAMA_HOST=http://127.0.0.1:11434
# Optional OpenAI-compatible endpoint (OpenAI, Groq, OpenRouter, LM Studio...)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Official posting APIs (only used when a platform's method is "api" in Settings).
# YouTube uses OAuth: put client_secret.json in config/secrets/ and click "Connect YouTube API".
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
TIKTOK_ACCESS_TOKEN=
